PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/deeptrust_academy
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/deeptrust_academy

# Authentication & Session Management
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# AI Services
SIGHTENGINE_API_USER=replace_with_sightengine_api_user
SIGHTENGINE_API_SECRET=replace_with_sightengine_api_secret
AI_GENERATED_THRESHOLD=0.8

# Optional Self-Hosted or Cloud CompreFace Face Verification Service
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=replace_with_compreface_api_key


