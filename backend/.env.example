# ==============================================================================
# DeepTrust Academy Backend — Production & Development Configuration Template
# ==============================================================================
# Instructions:
# - For local development, copy this file to backend/.env and populate local values.
# - For Render deployment, add these key-value pairs into the Render Environment tab.
# - NEVER commit files containing actual secrets to source control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (Vercel production URL, local dev)
FRONTEND_URL=https://deep-fake-cfa8.vercel.app
CLIENT_URL=https://deep-fake-cfa8.vercel.app,http://localhost:5173

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<db_username>:<db_password>@<cluster-host>/deeptrust_academy?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/deeptrust_academy?retryWrites=true&w=majority

# JWT & Session Security
# Generate high-entropy 64-char hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cross-Site Cookie Settings (Required for Vercel -> Render cross-domain cookie transmission)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Python Execution Environment (Set to 'python3' for Render Linux runtime, 'python' on Windows)
PYTHON_PATH=python3

# Optional Remote FastAPI AI Service
# If set, Node will call this FastAPI service for AI verification, with automatic fallback to local CV engine
# FASTAPI_AI_URL=https://your-fastapi-service.onrender.com
# AI_SERVICE_URL=https://your-fastapi-service.onrender.com

# AI Detection Services (Sightengine API)
SIGHTENGINE_API_USER=1791741482
SIGHTENGINE_API_SECRET=LTMPSsfTih5ATWqCCbWKpxh6Sj3TZcqo
AI_GENERATED_THRESHOLD=0.8

# Optional Facial Verification Microservice (CompreFace)
# COMPREFACE_URL=http://localhost:8000
# COMPREFACE_API_KEY=replace_with_compreface_api_key
